# Copy this file to ".env" (the real .env is git-ignored, never commit it).
# docker compose reads it automatically.

MYSQL_ROOT_PASSWORD=rootpass

# At least 32 random characters. Generate one in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
